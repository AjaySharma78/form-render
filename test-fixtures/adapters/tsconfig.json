{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "schema-form-engine": ["../../dist/index.d.ts"],
      "schema-form-engine/*": ["../../dist/*"]
    }
  },
  "include": ["src", "stubs"],
  "exclude": ["src/shadcn-adapter.tsx", "src/dropzone.tsx"]
}
